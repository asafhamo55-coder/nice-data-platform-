# ─── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (local or hosted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nice_dp_coe"

# ─── AI / LLM ─────────────────────────────────────────────────────
# Anthropic API key for the AI assistant and agent features
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key"

# ─── GitHub (optional) ─────────────────────────────────────────────
# Used by the vendor-scout agent to fetch GitHub repo metrics
# Without this, GitHub API calls are rate-limited to 60/hour
GITHUB_TOKEN=""

# ─── Supabase (optional) ──────────────────────────────────────────
# Only needed if using Supabase realtime for live news updates
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── App ───────────────────────────────────────────────────────────
# Base URL for the app (used in API routes for internal calls)
NEXT_PUBLIC_BASE_URL="http://localhost:3005"
